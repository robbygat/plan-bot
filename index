  }
}

// BUG FIXED: Handles null content directly allowing 'typing' bubbles without reading properties of null
function appendMsg(type, content, delay = 0) {
  return new Promise(resolve => {
    setTimeout(() => {
      const msg = document.createElement('div');
      msg.className = 'msg ' + (type === 'user' ? 'msg-user' : 'msg-bot');

      if (type === 'typing') {
        msg.innerHTML = `<div class="msg-typing"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>`;
        demoMessages.appendChild(msg);
        demoMessages.scrollTop = demoMessages.scrollHeight;
        resolve(msg);
        return;
      }

      if (!content) return resolve(msg); // safe fallback if content is null

      if (typeof content === 'string') {
        msg.innerHTML = `<div class="msg-bubble">${content}</div><div class="msg-time">Just now</div>`;
      } else if (content.type === 'weather') {
        msg.innerHTML = `
          <div class="msg-bubble">${content.text || ''}</div>
          <div class="msg-weather-card" style="margin-top:6px">
            <div class="weather-header">
              <span class="weather-icon">${content.icon}</span>
              <div>
                <div class="weather-title">${content.date} — Weather Check</div>
                <div class="weather-date">Live forecast data</div>
              </div>
            </div>
            <div class="weather-alert">${content.alert}</div>
            <div class="weather-stats">
              <div class="weather-stat"><strong>${content.temp}</strong>Temp</div>
              <div class="weather-stat"><strong>${content.rain}</strong>Rain</div>
              <div class="weather-stat"><strong>${content.wind}</strong>Wind</div>
            </div>
          </div>
          <div class="msg-time">Just now</div>`;
      } else if (content.type === 'calendar') {
        msg.innerHTML = `
          <div class="msg-bubble">${content.text || ''}</div>
          <div class="msg-weather-card" style="margin-top:6px;border-color:rgba(34,197,94,0.3);">
            <div class="weather-header">
              <span class="weather-icon" style="color:#16a34a">${content.icon}</span>
              <div>
                <div class="weather-title">${content.date} — Perfect Day!</div>
                <div class="weather-date">Recommended date</div>
              </div>
            </div>
            <div class="weather-stats">
              <div class="weather-stat"><strong>${content.temp}</strong>Temp</div>
              <div class="weather-stat"><strong>${content.rain}</strong>Rain</div>
              <div class="weather-stat"><strong>${content.wind}</strong>Wind</div>
            </div>
          </div>
          <div class="msg-time">Just now</div>`;
      } else if (content.type === 'guestList') {
        const chips = content.channels.map(c => `
          <div style="display:flex;align-items:center;gap:8px;background:#f7f7f9;border-radius:10px;padding:8px 10px;margin:4px 0;">
            <span style="font-size:16px">${c.icon}</span>
            <span style="font-size:12px;font-weight:600;color:#1A0A0F">${c.name}</span>
            <span style="margin-left:auto;font-size:11px;color:#A06080;background:rgba(255,0,85,0.08);padding:2px 8px;border-radius:50px;">${c.count}</span>
          </div>`).join('');
        msg.innerHTML = `
          <div class="msg-bubble">${content.text || ''}</div>
          <div style="background:white;border-radius:14px;border:1.5px solid rgba(255,0,85,0.12);padding:12px;margin-top:6px;">
            ${chips}
          </div>
          <div class="msg-time">Just now</div>`;
      } else if (content.type === 'rsvpTracker') {
        const total = content.confirmed + content.declined + content.pending;
        msg.innerHTML = `
          <div class="msg-bubble">${content.text || ''}</div>
          <div style="background:white;border-radius:14px;border:1.5px solid rgba(255,0,85,0.12);padding:14px;margin-top:6px;">
            <div style="display:flex;gap:8px;margin-bottom:10px;">
              <div style="flex:1;background:rgba(34,197,94,0.08);border-radius:10px;padding:10px;text-align:center;">
                <div style="font-size:22px;font-weight:800;color:#16a34a;font-family:'Syne',sans-serif">${content.confirmed}</div>
                <div style="font-size:10px;color:#16a34a;font-weight:600">Confirmed</div>
              </div>
              <div style="flex:1;background:rgba(239,68,68,0.08);border-radius:10px;padding:10px;text-align:center;">
                <div style="font-size:22px;font-weight:800;color:#dc2626;font-family:'Syne',sans-serif">${content.declined}</div>
                <div style="font-size:10px;color:#dc2626;font-weight:600">Declined</div>
              </div>
              <div style="flex:1;background:rgba(245,158,11,0.08);border-radius:10px;padding:10px;text-align:center;">
                <div style="font-size:22px;font-weight:800;color:#d97706;font-family:'Syne',sans-serif">${content.pending}</div>
                <div style="font-size:10px;color:#d97706;font-weight:600">Pending</div>
              </div>
            </div>
            <div style="background:#f7f7f9;border-radius:8px;overflow:hidden;height:6px;">
              <div style="height:100%;width:${(content.confirmed/total)*100}%;background:linear-gradient(90deg,var(--hot-pink),var(--light-pink));border-radius:8px;transition:width 0.5s;"></div>
            </div>
            <div style="font-size:10px;color:var(--text-light);margin-top:5px;text-align:right;">${content.confirmed} of ${total} responded</div>
          </div>
          <div class="msg-time">Just now</div>`;
      } else if (content.type === 'confirm') {
        const details = content.details.map(d => `<div class="confirm-detail"><div class="confirm-check"><i data-feather="check" style="width:10px;"></i></div>${d}</div>`).join('');
        msg.innerHTML = `
          <div class="msg-confirm-card">
            <div class="confirm-title">${content.title}</div>
            <div class="confirm-details">${details}</div>
          </div>
          <div class="msg-time">Just now</div>`;
      }

      demoMessages.appendChild(msg);
      demoMessages.scrollTop = demoMessages.scrollHeight;
      feather.replace(); // Ensure dynamic icons render
      resolve(msg);
    }, delay);
  });
}

async function showTypingThenMsg(content, typingDelay = 500, msgDelay = 1400) {
  // BUG FIXED: Calls 'typing' to correctly render bubbles before showing content
  const typingMsg = await appendMsg('typing', null, typingDelay); 
  demoMessages.scrollTop = demoMessages.scrollHeight;

  return new Promise(resolve => {
    setTimeout(() => {
      typingMsg.remove();
      appendMsg('bot', content).then(resolve);
    }, msgDelay);
  });
}

let demoState = 0;
let isTyping = false;

async function handleDemoSend() {
  if (isTyping) return;
  const text = demoInput.value.trim();
  if (!text) return;

  isTyping = true;
  demoInput.value = '';
  demoInput.disabled = true;

  await appendMsg('user', text);

  if (demoState === 0) {
    setActiveStep(1);
    await showTypingThenMsg({ type: 'text', text: `Love it! Let me run a <strong>live weather check</strong> for your event date...` }, 300, 1200);
    await showTypingThenMsg({
      type: 'weather',
      text: '',
      date: 'Saturday, June 14',
      icon: '<i data-feather="cloud-rain"></i>',
      alert: '<i data-feather="alert-triangle" style="width: 14px;"></i> 78% chance of heavy rain, 12pm–9pm',
      temp: '19°C',
      rain: '78%',
      wind: '42km/h'
    }, 400, 1600);
    await showTypingThenMsg('Rain is very likely that day. I recommend we shift. Let me check the next clear day for you!', 300, 1000);
    await showTypingThenMsg({
      type: 'calendar',
      text: '',
      date: 'Sunday, June 15',
      icon: '<i data-feather="sun"></i>',
      temp: '26°C',
      rain: '5%',
      wind: '12km/h'
    }, 300, 1200);
    await showTypingThenMsg('June 15 looks perfect. Now, who should I invite? Send me names, numbers, or emails.', 200, 900);
    demoState = 1;
    setActiveStep(2);

  } else if (demoState === 1) {
    await showTypingThenMsg('Got it! I can see how to reach each of your guests.', 300, 1000);
    await showTypingThenMsg({
      type: 'guestList',
      text: '',
      channels: [
        { icon: '<i data-feather="message-circle"></i>', name: 'WhatsApp', count: '9 guests' },
        { icon: '<i data-feather="message-square"></i>', name: 'LINE', count: '4 guests' },
        { icon: '<i data-feather="mail"></i>', name: 'Email', count: '5 guests' },
        { icon: '<i data-feather="smartphone"></i>', name: 'SMS', count: '2 guests' },
      ]
    }, 400, 1400);
    await showTypingThenMsg('Personalised invites sent to all 20 guests in their preferred app! Watching for RSVPs now...', 300, 1000);
    demoState = 2;
    setActiveStep(3);

  } else if (demoState === 2) {
    await showTypingThenMsg('RSVPs are coming in fast! Here\'s the live tracker.', 300, 1000);
    await showTypingThenMsg({
      type: 'rsvpTracker',
      text: '',
      confirmed: 14,
      declined: 2,
      pending: 4,
    }, 400, 1400);
    await showTypingThenMsg('14 confirmed and counting! Shall I build the shopping list based on confirmed headcount?', 300, 1000);
    demoState = 3;
    setActiveStep(4);

  } else if (demoState === 3) {
    await showTypingThenMsg('Your event is locked and loaded! Here\'s the full summary.', 300, 1000);
    await showTypingThenMsg({
      type: 'confirm',
      title: 'Your Event Is Fully Booked!',
      details: [
        'Sunday June 15 — clear skies, 26°C',
        '14 confirmed guests (2 vegetarian)',
        'Rooftop — directions sent to all guests',
        'Shopping list: 47 items generated',
        'Reminders set: 24hr & 1hr before',
      ]
    }, 400, 1400);
    await showTypingThenMsg('You\'re all set! Just show up and enjoy your own party — I\'ll handle any last-minute changes.', 300, 1000);
    demoState = 4;

  } else {
    await showTypingThenMsg('Your event is already fully planned! Start a new event anytime by refreshing this demo.', 300, 1000);
  }

  isTyping = false;
  demoInput.disabled = false;
  demoInput.focus();
}

demoInput.addEventListener('keypress', (e) => {
  if (e.key === 'Enter') handleDemoSend();
});
