<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plan Bot — Your Invisible Event Planning Partner</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
<!-- Professional vector icons to replace emojis -->
<script src="https://unpkg.com/feather-icons"></script>
<style>
  :root {
    --hot-pink: #FF0055;
    --magenta: #E8004D;
    --light-pink: #FF6B9D;
    --pale-pink: #FFB3CC;
    --blush: #FFD6E7;
    --super-pale: #FFF0F5;
    --white: #FFFFFF;
    --dark-rose: #8B0038;
    --soft-gray: #F7F7F9;
    --text-dark: #1A0A0F;
    --text-mid: #5C2D42;
    --text-light: #A06080;
    --bubble-pink: #FF8CB8;
    --glow: rgba(255, 0, 85, 0.15);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--white);
    color: var(--text-dark);
    overflow-x: hidden;
  }

  .feather {
    width: 20px;
    height: 20px;
    stroke-width: 2.5;
  }

  /* ───────────── NAV ───────────── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 18px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,0,85,0.08);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .nav-logo-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    object-fit: cover;
  }

  .nav-logo-text {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: var(--hot-pink);
    letter-spacing: -0.5px;
  }

  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
  }

  .nav-links a {
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 14px;
    color: var(--text-mid);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--hot-pink); }

  .nav-cta {
    background: var(--hot-pink);
    color: var(--white) !important;
    padding: 10px 22px;
    border-radius: 50px;
    font-weight: 600 !important;
    transition: transform 0.2s, box-shadow 0.2s !important;
    box-shadow: 0 4px 20px rgba(255,0,85,0.3);
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(255,0,85,0.4) !important;
    color: var(--white) !important;
  }

  /* ───────────── HERO ───────────── */
  .hero {
    min-height: 100vh;
    background: linear-gradient(135deg, #fff0f5 0%, #ffffff 50%, #fff0f8 100%);
    display: flex;
    align-items: center;
    padding: 120px 48px 80px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px; right: -200px;
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(255,0,85,0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -100px; left: -100px;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(255,107,157,0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hero-left { position: relative; z-index: 2; }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,0,85,0.08);
    border: 1px solid rgba(255,0,85,0.2);
    border-radius: 50px;
    padding: 6px 16px 6px 10px;
    margin-bottom: 28px;
    animation: fadeSlideUp 0.6s ease both;
  }

  .hero-badge-dot {
    width: 8px; height: 8px;
    background: var(--hot-pink);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.8); }
  }

  .hero-badge span {
    font-size: 12px;
    font-weight: 600;
    color: var(--hot-pink);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .hero-headline {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(44px, 5vw, 72px);
    line-height: 1.05;
    color: var(--text-dark);
    margin-bottom: 24px;
    animation: fadeSlideUp 0.6s ease 0.1s both;
  }

  .hero-headline .accent {
    color: var(--hot-pink);
    position: relative;
  }

  .hero-headline .accent::after {
    content: '';
    position: absolute;
    bottom: 4px; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--hot-pink), var(--light-pink));
    border-radius: 2px;
    opacity: 0.4;
  }

  .hero-sub {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-mid);
    margin-bottom: 40px;
    max-width: 480px;
    animation: fadeSlideUp 0.6s ease 0.2s both;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    animation: fadeSlideUp 0.6s ease 0.3s both;
  }

  .btn-primary {
    background: var(--hot-pink);
    color: white;
    padding: 16px 32px;
    border-radius: 50px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    box-shadow: 0 8px 30px rgba(255,0,85,0.35);
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    cursor: pointer;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(255,0,85,0.45);
    background: var(--magenta);
  }

  .btn-secondary {
    color: var(--text-mid);
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 8px;
    transition: color 0.2s;
  }

  .btn-secondary:hover { color: var(--hot-pink); }

  .hero-trust {
    margin-top: 48px;
    animation: fadeSlideUp 0.6s ease 0.4s both;
  }

  .hero-trust p {
    font-size: 12px;
    color: var(--text-light);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .platform-chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .platform-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    background: white;
    border: 1px solid rgba(255,0,85,0.15);
    border-radius: 50px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-mid);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .platform-chip .feather {
    width: 14px; height: 14px;
    color: var(--hot-pink);
  }

  /* ───────────── PHONE MOCKUP ───────────── */
  .hero-phone {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    animation: fadeSlideUp 0.6s ease 0.2s both;
    perspective: 1000px; /* Essential for 3D tilt */
  }

  .phone-wrap {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out; /* Smooth mouse tracking */
  }

  .phone-glow {
    position: absolute;
    inset: -40px;
    background: radial-gradient(ellipse, rgba(255,0,85,0.12) 0%, transparent 70%);
    pointer-events: none;
    border-radius: 50%;
    transform: translateZ(-50px); /* Pushes glow behind phone */
  }

  .phone-frame {
    width: 340px;
    background: var(--white);
    border-radius: 44px;
    box-shadow:
      0 0 0 10px #1a0a0f,
      0 0 0 12px rgba(255,255,255,0.2),
      0 40px 80px rgba(26,10,15,0.25),
      0 0 100px rgba(255,0,85,0.1);
    overflow: hidden;
    position: relative;
    transform: translateZ(20px); /* Pops phone out for 3D effect */
  }

  .phone-notch {
    background: #1a0a0f;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .phone-notch::after {
    content: '';
    width: 100px;
    height: 22px;
    background: #1a0a0f;
    border-radius: 0 0 18px 18px;
    position: absolute;
    top: 0;
    box-shadow: 0 4px 8px rgba(0,0,0,0.4);
  }

  .phone-status {
    position: absolute;
    top: 10px;
    left: 0; right: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    font-size: 11px;
    font-weight: 600;
    color: white;
    z-index: 2;
  }

  .chat-app {
    background: #f7f7f9;
    min-height: 620px;
    display: flex;
    flex-direction: column;
  }

  .chat-header {
    background: white;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .chat-avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .chat-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chat-header-info { flex: 1; }

  .chat-header-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: var(--text-dark);
  }

  .chat-header-status {
    font-size: 11px;
    color: #22c55e;
    font-weight: 500;
  }

  .chat-messages {
    flex: 1;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    max-height: 460px;
  }

  .msg {
    max-width: 80%;
    animation: msgPop 0.3s ease both;
  }

  @keyframes msgPop {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .msg-bot { align-self: flex-start; }
  .msg-user { align-self: flex-end; }

  .msg-bubble {
    padding: 10px 14px;
    border-radius: 18px;
    font-size: 13px;
    line-height: 1.5;
  }

  .msg-bot .msg-bubble {
    background: white;
    color: var(--text-dark);
    border-bottom-left-radius: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }

  .msg-user .msg-bubble {
    background: var(--hot-pink);
    color: white;
    border-bottom-right-radius: 4px;
  }

  .msg-time {
    font-size: 10px;
    color: var(--text-light);
    margin-top: 3px;
    text-align: right;
    padding: 0 4px;
  }

  .msg-bot .msg-time { text-align: left; }

  .msg-weather-card {
    background: white;
    border-radius: 14px;
    border: 1.5px solid rgba(255,0,85,0.15);
    padding: 12px;
    margin-top: 6px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.03);
  }

  .weather-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .weather-icon {
    color: var(--hot-pink);
  }

  .weather-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .weather-date {
    font-size: 10px;
    color: var(--text-light);
  }

  .weather-alert {
    background: rgba(255,180,0,0.1);
    border: 1px solid rgba(255,180,0,0.3);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 11px;
    color: #8B6000;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .weather-stats {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .weather-stat {
    font-size: 10px;
    color: var(--text-light);
  }

  .weather-stat strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-dark);
  }

  .msg-options {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
  }

  .msg-option-btn {
    background: rgba(255,0,85,0.03);
    border: 1.5px solid rgba(255,0,85,0.15);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--hot-pink);
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .msg-option-btn:hover {
    background: var(--hot-pink);
    color: white;
    transform: translateX(3px);
  }

  .msg-typing {
    display: flex;
    gap: 4px;
    padding: 12px 16px;
    background: white;
    border-radius: 18px;
    border-bottom-left-radius: 4px;
    width: fit-content;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .typing-dot {
    width: 6px; height: 6px;
    background: var(--pale-pink);
    border-radius: 50%;
    animation: typingBounce 1.2s infinite;
  }

  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); background: var(--pale-pink); }
    30% { transform: translateY(-5px); background: var(--hot-pink); }
  }

  .msg-confirm-card {
    background: linear-gradient(135deg, var(--hot-pink), #FF6B9D);
    border-radius: 14px;
    padding: 14px;
    color: white;
    margin-top: 6px;
  }

  .confirm-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 8px;
  }

  .confirm-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .confirm-detail {
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.9;
  }

  .confirm-check {
    width: 16px; height: 16px;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    flex-shrink: 0;
  }

  .chat-input-row {
    background: white;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px solid rgba(0,0,0,0.06);
  }

  .chat-input {
    flex: 1;
    background: #f7f7f9;
    border: 1.5px solid rgba(255,0,85,0.15);
    border-radius: 20px;
    padding: 9px 14px;
    font-size: 12px;
    font-family: 'DM Sans', sans-serif;
    outline: none;
    color: var(--text-dark);
    transition: border-color 0.2s;
  }

  .chat-input:focus { border-color: var(--hot-pink); }

  .chat-send-btn {
    width: 36px; height: 36px;
    background: var(--hot-pink);
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    box-shadow: 0 4px 12px rgba(255,0,85,0.3);
  }

  .chat-send-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 18px rgba(255,0,85,0.4);
  }

  /* Floating bubbles behind phone */
  .float-bubble {
    position: absolute;
    border-radius: 16px;
    background: white;
    padding: 12px 16px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    font-size: 12px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: floatBob 4s ease-in-out infinite;
    white-space: nowrap;
    pointer-events: none;
    transform: translateZ(40px);
  }

  .float-bubble .feather {
    width: 16px; height: 16px;
    color: var(--hot-pink);
  }

  @keyframes floatBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .bubble-left {
    left: -160px;
    animation-delay: 0.5s;
  }

  .bubble-right {
    right: -160px;
    animation-delay: 1.5s;
  }

  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ───────────── SOCIAL PROOF STRIP ───────────── */
  .proof-strip {
    background: var(--hot-pink);
    padding: 20px 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 60px;
    overflow: hidden;
  }

  .proof-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    white-space: nowrap;
  }

  .proof-number {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 28px;
    color: white;
  }

  .proof-label {
    font-size: 13px;
    opacity: 0.85;
    font-weight: 400;
    line-height: 1.3;
  }

  .proof-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.25);
  }

  /* ───────────── HOW IT WORKS ───────────── */
  .section {
    padding: 100px 48px;
  }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--hot-pink);
    margin-bottom: 14px;
  }

  .section-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.1;
    color: var(--text-dark);
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 18px;
    font-weight: 300;
    color: var(--text-mid);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 60px;
  }

  /* ───────────── STEPS ───────────── */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 60px;
  }

  .step-card {
    background: var(--white);
    border: 1.5px solid rgba(255,0,85,0.1);
    border-radius: 24px;
    padding: 32px 24px;
    position: relative;
    transition: all 0.3s;
    cursor: default;
  }

  .step-card:hover {
    border-color: var(--hot-pink);
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(255,0,85,0.1);
  }

  .step-number {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 56px;
    color: rgba(255,0,85,0.06);
    line-height: 1;
    position: absolute;
    top: 16px; right: 20px;
  }

  .step-icon {
    width: 52px; height: 52px;
    background: var(--super-pale);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--hot-pink);
    margin-bottom: 20px;
    border: 1.5px solid rgba(255,0,85,0.12);
  }

  .step-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 17px;
    color: var(--text-dark);
    margin-bottom: 10px;
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-mid);
  }

  /* ───────────── FEATURES ───────────── */
  .features-bg {
    background: linear-gradient(160deg, var(--super-pale) 0%, white 100%);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .feature-card {
    background: white;
    border-radius: 24px;
    padding: 36px 32px;
    border: 1.5px solid rgba(255,0,85,0.08);
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--hot-pink), var(--light-pink));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }

  .feature-card:hover::before { transform: scaleX(1); }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(255,0,85,0.08);
    border-color: rgba(255,0,85,0.2);
  }

  .feature-icon-wrap {
    width: 60px; height: 60px;
    border-radius: 18px;
    background: var(--super-pale);
